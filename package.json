{
  "name": "kernel-launcher",
  "version": "1.1.0",
  "description": "Kernel Launcher",
  "author": "Kernel Launcher Team",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "dependencies": {
    "adm-zip": "^0.5.10",
    "marked": "^12.0.0",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.kernel.launcher",
    "copyright": "Copyright © Kernel Launcher Team",
    "productName": "Kernel Launcher",
    "directories": {
      "output": "dist"
    },
    "win": {
      "forceCodeSigning": false,
      "signAndEditExecutable": false,
      "icon": "build/icon.ico",
      "target": [
        { "target": "portable", "arch": ["x64"] },
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kernel Launcher"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "main.js"
    }
  },
  "allowScripts": {
    "electron@30.5.1": true
  }
}
